# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/lttms

# JWT Authentication (generate strong 64-char strings for production)
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-this-to-another-random-64-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Frontend CORS Allowed Origins (comma-separated)
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:8080

# Chapa Payment Gateway (https://chapa.co)
CHAPA_SECRET_KEY=
CHAPA_API_URL=https://api.chapa.co/v1
CHAPA_CALLBACK_URL=http://localhost:5000/api/v1/payments/verify
CHAPA_WEBHOOK_SECRET=

# SMTP Email Transport (defaults to Ethereal in development if empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lake Tana Eco-Tourism" <noreply@laketana.com>

# Structured Logging Level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info
