PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/lttms

# JWT
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-this-to-another-random-64-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Frontend
FRONTEND_ORIGIN=http://localhost:3000

# Chapa Payment Gateway (https://chapa.co)
CHAPA_SECRET_KEY=
CHAPA_API_URL=https://api.chapa.co/v1
CHAPA_CALLBACK_URL=http://localhost:5000/api/payments/verify
CHAPA_WEBHOOK_SECRET=

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@laketana.com

# Logging
LOG_LEVEL=info
