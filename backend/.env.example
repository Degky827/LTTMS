# ==============================================================================
# Lake Tana Tourism Management System (LTTMS V1)
# Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - Copy this file to `.env` in the backend directory for local development.
# - In production/staging, inject secrets via environment variables or secret manager.
# - DO NOT commit `.env` containing real production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# ------------------------------------------------------------------------------
# Node runtime environment: 'development', 'production', or 'test'
NODE_ENV=production

# HTTP Port the Express application listens on
PORT=5000

# Reverse proxy trust level (1 for single hop behind Nginx/Render/Cloudflare)
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MONGODB)
# ------------------------------------------------------------------------------
# Standalone or replica-set connection string
# Development default: mongodb://localhost:27017/lttms
# Docker Compose default: mongodb://mongodb:27017/lttms
# Production authenticated: mongodb://app_user:STRONG_PASSWORD@mongodb:27017/lttms?authSource=admin
MONGODB_URI=mongodb://mongodb:27017/lttms

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SESSION MANAGEMENT
# ------------------------------------------------------------------------------
# In production, JWT_SECRET must be at least 32 characters long.
# Generate secure secrets using: openssl rand -base64 48
JWT_SECRET=replace_with_a_cryptographically_secure_random_64_character_secret_key
JWT_REFRESH_SECRET=replace_with_a_cryptographically_secure_random_64_character_refresh_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=lttms-api
JWT_AUDIENCE=lttms-client

# ------------------------------------------------------------------------------
# 4. CORS & FRONTEND CLIENT URLS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for browser requests & redirect targets
# Aliases accepted: FRONTEND_ORIGIN, FRONTEND_URL, CORS_ORIGINS
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:8080

# ------------------------------------------------------------------------------
# 5. CHAPA PAYMENT GATEWAY (https://chapa.co)
# ------------------------------------------------------------------------------
# Chapa API keys from dashboard (test keys: CHASECK_TEST-..., live keys: CHASECK-...)
CHAPA_SECRET_KEY=CHASECK_TEST-your_chapa_secret_key_here
CHAPA_API_URL=https://api.chapa.co/v1
CHAPA_CALLBACK_URL=http://localhost:5000/api/v1/payments/verify
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_hash_here

# ------------------------------------------------------------------------------
# 6. SMTP TRANSACTIONAL EMAIL
# ------------------------------------------------------------------------------
# Used for user email verification, password reset, and booking confirmations
# In development, leave blank to use ethereal.email test transport automatically.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lake Tana Eco-Tourism" <noreply@laketana.com>

# ------------------------------------------------------------------------------
# 7. STRUCTURED LOGGING
# ------------------------------------------------------------------------------
# Levels: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
