{
  "name": "lttms-backend",
  "version": "1.0.0",
  "description": "Backend for Lake Tana Tourism Management System",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "node --test",
    "test:jest": "jest",
    "test:coverage": "jest --coverage",
    "test:unit": "node --test backend/tests/models.test.js backend/tests/validate.test.js",
    "test:integration": "node --test backend/tests/step6_booking_engine.test.js backend/tests/step7_payment_finance.test.js backend/tests/step8_reviews_support_admin.test.js",
    "test:security": "node --test backend/tests/security_hardening_swagger.test.js",
    "test:all": "node --test",
    "migrate": "node migrations/001_v1_database_upgrade.js",
    "migrate:dry-run": "node migrations/001_v1_database_upgrade.js --dry-run",
    "verify:deployment": "node ../scripts/verify-deployment.js",
    "seed": "node seed.js"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.4",
    "multer": "^2.1.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^8.0.7",
    "otplib": "^13.4.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2"
  }
}
