# ==============================================================================
# LTTMS Frontend Environment Variables Configuration
# ==============================================================================

# Public API REST endpoint URL (backend modular monolith)
# Local: http://localhost:5000/api/v1
# Production (Render): https://lttms.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Real-time WebSocket Gateway URL
# Local: http://localhost:5000
# Production (Render): https://lttms.onrender.com
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Application Metadata
NEXT_PUBLIC_APP_NAME=Lake Tana Tourism Management System (LTTMS)
NEXT_PUBLIC_APP_URL=http://localhost:3000
